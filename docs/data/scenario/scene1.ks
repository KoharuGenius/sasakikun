; ==========================================
; 1. 初期化処理（フラグを3つ用意して0にする）
; ==========================================
[iscript]
f.flag1 = 0;
f.flag2 = 0;
f.flag3 = 0;
[endscript]

[macro name="qx_tukkomi"]
    [cm]
    ;@playse storage=""
    #佐々木
    いてッ！[p]
[endmacro]
; ==========================================
; 2. 選択肢表示・チェック用ラベル
; ==========================================
*qx_start

; --- クリア判定：3つのフラグがすべて 1 かどうかチェック ---
[if exp="f.flag1 == 1 && f.flag2 == 1 && f.flag3 == 1"]
    @jump target="*qx_all_cleared"
[endif]

; --- 選択肢の表示 ---
[cm]
選択肢を選んでください。[l][r]

; フラグ1がまだ立っていない場合のみ表示
[if exp="f.flag1 == 0"]
    [choice text="まず、服を脱ぎます" target="qxa"]
[endif]

; フラグ2がまだ立っていない場合のみ表示
[if exp="f.flag2 == 0"]
    [choice text="はるちゃんの身体に…" target="qxb"]
[endif]

; フラグ3がまだ立っていない場合のみ表示
[if exp="f.flag3 == 0"]
    [choice text="二人でさ…" target="qxc"]
[endif]

[s]

